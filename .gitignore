# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Sensitive variable files
*.tfvars
!*.tfvars.example
*.auto.tfvars
*.auto.tfvars.json

# Crash logs
crash.log
crash.*.log

# CLI override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment files
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# MongoDB TLS certificates and private keys
pki/
*.key
*.pem
*.p12
*.pfx
*.csr
*.crt
*.ext

# MongoDB internal authentication keyfile
rs0-keyfile
